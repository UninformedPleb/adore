<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <SignAssembly>False</SignAssembly>
    <Version>$(VersionPrefix)2.0.0</Version>
    <Description>ADO is Really Easy! Configuration mappings</Description>
    <Copyright>UninformedPleb (Matt Hanvelt)</Copyright>
    <PackageProjectUrl>https://github.com/UninformedPleb/adore</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/UninformedPleb/adore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>UninformedPleb</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>ADO;Database</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Metadata\TypeMapData.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Metadata\TypeMapData.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

</Project>
