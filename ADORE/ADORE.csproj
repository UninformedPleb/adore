<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Title>ADORE</Title>
    <Version>1.0.0</Version>
    <Authors>UninformedPleb</Authors>
    <Description>ADO is Really Easy! A full data-access layer, with a focus on clean, readable code.</Description>
    <Copyright>UninformedPleb (Matt Hanvelt)</Copyright>
    <PackageProjectUrl>https://github.com/UninformedPleb/adore</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/UninformedPleb/adore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ADO;Database</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ADORE.Configuration\ADORE.Configuration.csproj" />
  </ItemGroup>

</Project>
